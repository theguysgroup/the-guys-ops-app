{
 "about": "Recorded-style phase-4 automations (stage 2 phase 1 differential, design §8.3). The ready-made rows mirror the app's autoReadyRows shapes (review, chat text, missed-call text, team notifications); the custom rows mirror what the phase-4 builder saves (every step kind, window mode, outside variant, condition and action). Replace or extend with a READ-ONLY export of the live automations table (RUNBOOK step 3) via --corpus.",
 "automations": [
  {
   "name": "Review request after a closed job (ready-made shape)",
   "trigger": {
    "type": "jobClosed",
    "params": {}
   },
   "steps": [
    {
     "id": "r1",
     "kind": "window",
     "days": [
      0,
      1,
      2,
      3,
      4,
      5,
      6
     ],
     "from": "09:00",
     "until": "19:00",
     "outside": "at",
     "at": "10:00"
    },
    {
     "id": "r2",
     "kind": "if",
     "match": "all",
     "conds": [
      {
       "field": "dont_ask",
       "op": "true",
       "lock": true
      },
      {
       "field": "asked_within_months",
       "op": "true",
       "n": 6
      }
     ]
    },
    {
     "id": "r3",
     "kind": "action",
     "type": "text",
     "templateKey": "reviewSms"
    },
    {
     "id": "r4",
     "kind": "action",
     "type": "email",
     "templateKey": "reviewEmailBody",
     "subject": "How did we go, {first_name}?"
    }
   ]
  },
  {
   "name": "Text after an unanswered website chat (ready-made shape)",
   "trigger": {
    "type": "chat",
    "params": {}
   },
   "steps": [
    {
     "id": "c1",
     "kind": "wait",
     "n": 5,
     "unit": "minutes"
    },
    {
     "id": "c2",
     "kind": "if",
     "match": "all",
     "conds": [
      {
       "field": "has_mobile",
       "op": "true",
       "lock": true
      },
      {
       "field": "chat_age_hours",
       "op": "lte",
       "n": 12
      }
     ]
    },
    {
     "id": "c3",
     "kind": "action",
     "type": "text",
     "templateKey": "chatOpen"
    }
   ]
  },
  {
   "name": "Text after a missed call (ready-made shape)",
